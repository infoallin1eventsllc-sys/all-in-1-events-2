# Copy this file to `.env` and fill in the values you need.
# `.env` is gitignored — never commit real secrets.
# Only OWNER_PASSCODE is needed to click through the site locally.

# Unlocks the Owner Portal locally. 8 characters minimum; use a passphrase.
OWNER_PASSCODE=

# Optional — each one turns on a feature that would otherwise say it is unset.
# MERIDIAN_INTAKE_URL=      # sends "Join the list" signups to the CRM
# ANTHROPIC_API_KEY=        # the events-site concierge
# STRIPE_SECRET_KEY=        # card / Apple Pay / Google Pay / Cash App
# STRIPE_PAYMENT_METHODS=card,cashapp
