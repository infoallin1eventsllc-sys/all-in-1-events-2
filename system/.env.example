# Meridian Marketing System — operator CLI config
# Copy to system/.env and fill in. NEVER commit the real .env.

# Required for the CLI (admin reads + invoking functions).
# Find these in Supabase → Project Settings → API.
SUPABASE_URL=https://glzodwhyavexpuusbqjy.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ---------------------------------------------------------------------------
# The keys below are NOT read by the CLI. They must be set as SUPABASE SECRETS
# on the project (Supabase → Edge Functions → Secrets, or `supabase secrets set`)
# so the edge functions can use them. Listed here only as a checklist.
# ---------------------------------------------------------------------------
# ANTHROPIC_API_KEY=sk-ant-...        # required for REAL AI output (else mock mode)
# SENDGRID_API_KEY=SG....             # to actually send email
# SENDGRID_FROM_EMAIL=hello@yourdomain.com
# SENDGRID_FROM_NAME=Your Business
# TWILIO_ACCOUNT_SID=AC...            # to actually send SMS
# TWILIO_AUTH_TOKEN=...
# TWILIO_FROM_NUMBER=+1...
# WEBHOOK_SECRET=...                  # optional: require this on the intake webhook
