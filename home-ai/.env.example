# ---- Haven home agent configuration ----
# Copy to .env (never commit it) or set these in the environment.

# Port and bind address for the home server (run it on a box inside the house).
PORT=8787
HOST=0.0.0.0

# Owner access token for the app, Apple Shortcuts, and the car.
# Leave blank and Haven generates one on first start and prints it once.
HAVEN_OWNER_TOKEN=

# Claude powers the conversational agent and the written briefings.
# Without a key, Haven still runs every automation and uses a built-in
# command parser, so the house never depends on the internet.
ANTHROPIC_API_KEY=
HAVEN_MODEL=claude-opus-5

# Device backend: "simulator" (default, no hardware) or "homeassistant".
HAVEN_ADAPTER=simulator
HA_URL=http://homeassistant.local:8123
HA_TOKEN=

# Push notifications that reach iPhone and mirror to Apple Watch.
# Use either (or both). ntfy is free and self-hostable; Pushover is a one-time purchase.
NTFY_URL=https://ntfy.sh
NTFY_TOPIC=
NTFY_TOKEN=
PUSHOVER_TOKEN=
PUSHOVER_USER=
